// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Device {
  key            String   @id
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
  pendingCommand String? // "arm" | "reset" | "export", cleared once the device polls it
  lastKnownState String? // last state the device reported at check-in, e.g. "idle"
  runs           Run[]
}

model Run {
  id          Int      @id @default(autoincrement())
  deviceKey   String
  device      Device   @relation(fields: [deviceKey], references: [key], onDelete: Cascade)
  csvRaw      String
  sampleCount Int
  uploadedAt  DateTime @default(now())

  // Gravity baseline + deadzone the device itself computed during its real,
  // guaranteed-stationary STATE_CALIBRATING window (5s, before the car ever
  // launches) -- optional/nullable because older firmware never sent these
  // and older runs never stored them. When present, computeMotion() uses
  // them directly instead of re-deriving a baseline from the first N
  // seconds of the exported recording, which silently breaks for a car
  // that launches almost immediately (nothing left to calibrate against).
  calibGravityX  Float?
  calibGravityY  Float?
  calibGravityZ  Float?
  calibDeadzoneG Float?

  @@index([deviceKey, uploadedAt])
}
